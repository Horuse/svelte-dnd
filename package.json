{
	"name": "svelte-dnd",
	"version": "0.0.1",
	"private": true,
	"devDependencies": {
		"@types/bun": "latest",
		"prettier": "^3.8.1",
		"turbo": "^2.8.18"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"workspaces": [
		"packages/**",
		"apps/**"
	],
	"packageManager": "bun@1.3.8",
	"scripts": {
		"build": "bun --filter '*' build",
		"start": "bun --filter '*' start",
		"dev": "bun --filter '*' dev",
		"lint": "bun --filter '*' lint",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "bun --filter '*' check-types"
	}
}

{
	"name": "svelte-dnd",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"devDependencies": {
		"@types/bun": "latest",
		"prettier": "^3.8.1",
		"turbo": "^2.9.3"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"packageManager": "bun@1.3.11",
	"workspaces": [
		"apps/**",
		"packages/**"
	],
	"scripts": {
		"build": "bun --bun turbo run build",
		"dev": "bun --bun turbo run dev",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "bun --filter '*' check-types"
	}
}

{
	"name": "@horuse/svelte-dnd",
	"version": "1.0.0-beta.1",
	"description": "A drag-and-drop library for Svelte 5 with animated drop previews, auto-scroll, pointer & touch support, and multi-container support.",
	"scripts": {
		"build": "vite build && bun run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"author": "Horuse",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Horuse/svelte-dnd.git",
		"directory": "packages/svelte-dnd"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"publint": "^0.3.17",
		"svelte": "^5.53.13",
		"svelte-check": "^4.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1"
	},
	"homepage": "https://github.com/Horuse/svelte-dnd",
	"bugs": {
		"url": "https://github.com/Horuse/svelte-dnd/issues"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"svelte-5",
		"svelte-dnd",
		"drag",
		"drop",
		"drag-and-drop",
		"dnd",
		"sortable",
		"kanban"
	]
}
